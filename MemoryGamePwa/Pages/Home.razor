@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">
    <div class="card text-center mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h5 class="card-title">Select number of pieces</h5>
            <div class="d-grid gap-2">
                <button class="btn btn-primary" @onclick="() => StartGame(12)">12</button>
                <button class="btn btn-primary" @onclick="() => StartGame(18)">18</button>
                <button class="btn btn-primary" @onclick="() => StartGame(24)">24</button>
            </div>
        </div>
    </div>

    @if (selectedPieces != null)
    {
        <p class="mt-3">Game starting with @selectedPieces pieces.</p>
    }
</div>

@code {
    private int? selectedPieces = null;

    private void StartGame(int count)
    {
        selectedPieces = count;
    }
}
