@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">
    <div class="card text-center mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h5 class="card-title">Select number of pieces</h5>
            <div class="d-grid gap-2">
                <button class="btn btn-primary" @onclick="() => StartGame(12)">12</button>
                <button class="btn btn-primary" @onclick="() => StartGame(18)">18</button>
                <button class="btn btn-primary" @onclick="() => StartGame(24)">24</button>
            </div>
        </div>
    </div>

    @if (selectedPieces != null)
    {
        <p class="mt-3">Game starting with @selectedPieces pieces.</p>
        <div class="row">
            @foreach (var idx in pieceIndices)
            {
                <div class="col-2 mb-3">
                    <div class="card text-center" style="width:100px; height:140px;">
                        <div class="card-body d-flex align-items-center justify-content-center" style="background-color:#6c757d;">
                            <!-- Back side placeholder -->
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private int? selectedPieces = null;
        private List<int> pieceIndices = new();

    private void StartGame(int count)
    {
        selectedPieces = count;
        pieceIndices = System.Linq.Enumerable.Range(0, count).ToList();
    }
}
