@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">
  <div class="card text-center mx-auto" style="max-width:400px;">
    <div class="card-body">
      <h5 class="card-title">Select number of pieces</h5>
      @if (!IsGameStarted)
      {
        <div class="d-grid gap-2">
          <button class="btn btn-primary" @onclick="() => StartGame(12)">12</button>
          <button class="btn btn-primary" @onclick="() => StartGame(18)">18</button>
          <button class="btn btn-primary" @onclick="() => StartGame(24)">24</button>
        </div>
      }
      @if (IsGameStarted)
      {
          <button class="btn btn-primary mt-3" @onclick="ResetGame">New Game</button>
      }
    </div>
  </div>

  @if (selectedPieces != null)
  {
      <p class="mt-3">Game starting with @selectedPieces pieces.</p>
      <p class="mt-3">Player 1: @scores[0] | Player 2: @scores[1]</p>
      <p class="mt-3">Current turn: Player @currentPlayer</p>
      <div class="row">
          @foreach (var idx in pieceIndices)
          {
              <div class="col-2 mb-3">
                  <div class="card text-center" style="width:100px; height:140px;">
                      <div class="card-body d-flex align-items-center justify-content-center" style="@GetCardBackgroundColor(idx)" @onclick="(() => OnCardClicked(idx))">
                          @if (openIndices.Contains(idx) || matchedIndices.Contains(idx)) { <span>@pieceValues[idx]</span> }
                      </div>
                  </div>
              </div>
          }
      </div>
  }
</div>

@code {
    private int? selectedPieces = null;
    private bool IsGameStarted => selectedPieces.HasValue;

    private List<int> pieceIndices = new();
    private List<int> pieceValues = new();
    private List<int> openIndices = new();
    private HashSet<int> matchedIndices = new();
    private  Dictionary<int, int> pieceOwners = new();

    private int currentPlayer = 1;
    private int[] scores = new int[2];

    private void StartGame(int count)
        {
            selectedPieces = count;
            pieceIndices = [.. Enumerable.Range(0, count)];
            pieceOwners.Clear();
            pieceValues = GeneratePieceValues(count);
            openIndices.Clear();
            matchedIndices.Clear();
            currentPlayer = 1;
            scores[0] = 0;
            scores[1] = 0;
        }

        private string GetCardBackgroundColor(int idx)
        {
            if (matchedIndices.Contains(idx))
            {
                var owner = pieceOwners.GetValueOrDefault(idx, 0);
                return owner switch
                {
                    1 => "background-color:#3498db;", // blue for player 1
                    2 => "background-color:#2ecc71;", // green for player 2
                    _ => "background-color:#28a745;"    // default greenish if unknown
                };
            }
            else
            {
                return "background-color:#6c757d;";
            }
        }

    private void ResetGame()
    {
        selectedPieces = null;
        pieceIndices.Clear();
        pieceValues.Clear();
        openIndices.Clear();
        matchedIndices.Clear();
        pieceOwners.Clear();
        currentPlayer = 1;
        scores[0] = 0;
        scores[1] = 0;
    }

    private List<int> GeneratePieceValues(int count)
    {
        int pairs = count / 2;
        var values = Enumerable.Range(0, pairs)
            .SelectMany(v => new[] { v, v })
            .ToList();
        var rnd = new Random();
        return values.OrderBy(_ => rnd.Next()).ToList();
    }

    private void OnCardClicked(int idx)
    {
        if (openIndices.Contains(idx) || matchedIndices.Contains(idx))
            return;
        openIndices.Add(idx);
        StateHasChanged();
        if (openIndices.Count == 2)
        {
            var first = openIndices[0];
            var second = openIndices[1];
            if (pieceValues[first] == pieceValues[second])
            {
                matchedIndices.Add(first);
                matchedIndices.Add(second);
                // Assign ownership to current player before switching
                pieceOwners[first] = currentPlayer;
                pieceOwners[second] = currentPlayer;
                openIndices.Clear();
                scores[currentPlayer - 1]++;
            }
            else
            {
                _ = HideAfterDelay(first, second);
            }
            // Switch player for next round
            currentPlayer = currentPlayer == 1 ? 2 : 1;
        }
    }

    private async Task HideAfterDelay(int first, int second)
    {
        await Task.Delay(500);
        openIndices.Remove(first);
        openIndices.Remove(second);
        StateHasChanged();
    }
}
